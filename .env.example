# Local Docker defaults. For deployment use an HTTPS edge and the production values described in README.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER=gemini
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
ENVIRONMENT=development
SECURE_COOKIES=false
COOKIE_SAMESITE=strict
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_HOSTS=localhost,127.0.0.1
# Hosted Supabase values. Keep actual secrets in the host's environment settings.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=paperflow
INITIAL_ADMIN_EMAIL=lamhoangnhan20000@gmail.com
# One-time bootstrap account. Remove these two values after the first startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Configure these after registering a PayOS payment channel.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/billing/result
PAYOS_CANCEL_URL=http://localhost:5173/billing/result
